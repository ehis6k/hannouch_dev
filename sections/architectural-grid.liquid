{%- comment -%}
  Hannouch – Architectural Grid (Marachi Task 4)
  Image grid with optional uppercase titles and captions (e.g. brand spaces, architectural imagery).
{%- endcomment -%}

{{- 'component-architectural-grid.css' | asset_url | stylesheet_tag -}}

<div class="architectural-grid page-width" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank -%}
    <h2 class="architectural-grid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div
    class="architectural-grid__items architectural-grid__items--{{ section.settings.columns }}-col"
    role="list"
  >
    {%- for block in section.blocks -%}
      <div class="architectural-grid__item" {{ block.shopify_attributes }} role="listitem">
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="architectural-grid__link">
        {%- endif -%}

        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1200
            | image_tag: class: 'architectural-grid__image', loading: 'lazy', alt: block.settings.heading | escape
          }}
        {%- endif -%}

        {%- if block.settings.heading != blank or block.settings.caption != blank -%}
          <div class="architectural-grid__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="architectural-grid__item-heading">{{ block.settings.heading | escape | upcase }}</h3>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="architectural-grid__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Architectural Grid",
  "tag": "section",
  "class": "architectural-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (optional)"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (optional)"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Architectural Grid",
      "blocks": [
        { "type": "image_block" },
        { "type": "image_block" }
      ]
    }
  ]
}
{% endschema %}
