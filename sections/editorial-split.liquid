{%- comment -%}
  Hannouch – Editorial Split Section
  Task 11: sections/editorial-split.liquid

  50/50 desktop layout: image panel + text panel.
  Stacks vertically on mobile (image first, then text).
  Reverse option swaps image to right side.
{%- endcomment -%}

{{- 'component-editorial-split.css' | asset_url | stylesheet_tag -}}

{%- assign reverse = section.settings.reverse -%}
{%- assign has_image = false -%}
{%- if section.settings.image != blank -%}
  {%- assign has_image = true -%}
{%- endif -%}

{%- comment -%} Locale-aware heading/body/cta: when translation_namespace is set, read from locale keys {%- endcomment -%}
{%- assign _ns = section.settings.translation_namespace -%}
{%- if _ns != blank -%}
  {%- assign heading  = _ns | append: '_heading' | t -%}
  {%- assign body     = _ns | append: '_body'    | t -%}
  {%- assign cta_text = _ns | append: '_cta'     | t -%}
{%- else -%}
  {%- assign heading  = section.settings.heading -%}
  {%- assign body     = section.settings.body -%}
  {%- assign cta_text = section.settings.cta_text -%}
{%- endif -%}

{%- assign has_cta = false -%}
{%- if cta_text != blank and section.settings.cta_link != blank -%}
  {%- assign has_cta = true -%}
{%- endif -%}

<div class="editorial-split{% if reverse %} editorial-split--reverse{% endif %}">

  {%- comment -%} ── Image panel ── {%- endcomment -%}
  <div class="editorial-split__media">
    {%- if has_image -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000, format: 'avif' }}"
        srcset="
          {{ section.settings.image | image_url: width: 500,  format: 'avif' }}  500w,
          {{ section.settings.image | image_url: width: 800,  format: 'avif' }}  800w,
          {{ section.settings.image | image_url: width: 1000, format: 'avif' }} 1000w,
          {{ section.settings.image | image_url: width: 1400, format: 'avif' }} 1400w
        "
        sizes="(min-width: 750px) 50vw, 100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
        class="editorial-split__image"
      >
    {%- else -%}
      <div class="editorial-split__placeholder">
        {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' -}}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ── Text panel ── {%- endcomment -%}
  <div class="editorial-split__content">

    {%- if section.settings.eyebrow != blank -%}
      <p class="editorial-split__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h2 class="editorial-split__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if body != blank -%}
      <div class="editorial-split__body rte"><p>{{ body }}</p></div>
    {%- endif -%}

    {%- if section.settings.caption != blank -%}
      <p class="editorial-split__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}

    {%- if has_cta -%}
      <a
        href="{{ section.settings.cta_link }}"
        class="editorial-split__cta"
      >
        {{- cta_text | escape -}}
        {%- render 'icon-arrow' -%}
      </a>
    {%- endif -%}

  </div>

</div>

<script type="module">
  {%- comment -%} Scroll entrance: adds .is-visible once section enters the viewport {%- endcomment -%}
  const sections = document.querySelectorAll('.editorial-split');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    sections.forEach(s => observer.observe(s));
  } else {
    sections.forEach(s => s.classList.add('is-visible'));
  }
</script>

{% schema %}
{
  "name": "Editorial Split",
  "tag": "section",
  "class": "editorial-split-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "natural",  "label": "Natural (original)"  },
        { "value": "portrait", "label": "Portrait (3:4)"      },
        { "value": "square",   "label": "Square (1:1)"        },
        { "value": "fill",     "label": "Fill panel height"   }
      ],
      "default": "fill"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "placeholder": "The Edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE CITY EDIT"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Designed for the woman in motion. Pieces that move through your day with the same quiet confidence you carry.</p>"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Small italic text below body copy, e.g. collection name or season."
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Link text",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout (image right)",
      "default": false
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "Minimum section height",
      "options": [
        { "value": "none",   "label": "None (auto)"    },
        { "value": "medium", "label": "Medium (60vh)"  },
        { "value": "large",  "label": "Large (80vh)"   },
        { "value": "full",   "label": "Full (100svh)"  }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "translation_namespace",
      "label": "Locale namespace (optional)",
      "info": "e.g. 'home.editorial_1' uses home.editorial_1_heading, _body, _cta from locale files. Leave blank to use the text fields above."
    }
  ],
  "presets": [
    {
      "name": "Editorial Split",
      "category": "Editorial"
    }
  ]
}
{% endschema %}
