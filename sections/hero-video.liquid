{%- comment -%}
  Hannouch – Hero Video Section
  Task 10: sections/hero-video.liquid

  Full-viewport hero with autoplay video (desktop) + image fallback (mobile).
  Text is centered by default; overlay opacity is merchant-adjustable.
{%- endcomment -%}

{{- 'component-hero.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign has_video         = false
  assign has_desktop_image = false
  assign has_mobile_image  = false

  if section.settings.video != blank
    assign has_video = true
  endif
  if section.settings.image != blank
    assign has_desktop_image = true
  endif
  if section.settings.mobile_image != blank
    assign has_mobile_image = true
  endif

  assign text_align = section.settings.text_position | default: 'center'
  assign overlay_opacity = section.settings.overlay_opacity | default: 35
  assign overlay_opacity_decimal = overlay_opacity | times: 0.01
-%}

<section
  class="hero-video hero-video--align-{{ text_align }}"
  aria-label="{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'home.hero_title' | t | escape }}{% endif %}"
>

  {%- comment -%} ── Background media ── {%- endcomment -%}
  <div class="hero-video__media-wrapper" aria-hidden="true">

    {%- if has_video -%}
      {%- comment -%} Desktop video — hidden on mobile via CSS {%- endcomment -%}
      <video
        class="hero-video__video hero-video__media mobile:hidden"
        autoplay
        muted
        loop
        playsinline
        {%- if has_desktop_image %}
          poster="{{ section.settings.image | image_url: width: 1920 }}"
        {%- endif %}
      >
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>
    {%- endif -%}

    {%- comment -%} Desktop fallback image (shown when no video, or as poster) {%- endcomment -%}
    {%- if has_desktop_image -%}
      <img
        src="{{ section.settings.image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.image | image_url: width: 750,  format: 'avif' }}  750w,
          {{ section.settings.image | image_url: width: 1200, format: 'avif' }} 1200w,
          {{ section.settings.image | image_url: width: 1920, format: 'avif' }} 1920w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
        class="hero-video__image hero-video__media{% if has_video %} desktop:hidden{% endif %}"
      >
    {%- endif -%}

    {%- comment -%} Mobile-specific image {%- endcomment -%}
    {%- if has_mobile_image -%}
      <img
        src="{{ section.settings.mobile_image | image_url: width: 750 }}"
        srcset="
          {{ section.settings.mobile_image | image_url: width: 375,  format: 'avif' }}  375w,
          {{ section.settings.mobile_image | image_url: width: 750,  format: 'avif' }}  750w,
          {{ section.settings.mobile_image | image_url: width: 1080, format: 'avif' }} 1080w
        "
        sizes="100vw"
        alt="{{ section.settings.mobile_image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.mobile_image.width }}"
        height="{{ section.settings.mobile_image.height }}"
        loading="eager"
        fetchpriority="high"
        class="hero-video__image hero-video__media hero-video__image--mobile desktop:hidden"
      >
    {%- elsif has_desktop_image and has_video -%}
      {%- comment -%} Re-use desktop image as mobile fallback if no dedicated mobile image set {%- endcomment -%}
      <img
        src="{{ section.settings.image | image_url: width: 750 }}"
        srcset="
          {{ section.settings.image | image_url: width: 375,  format: 'avif' }}  375w,
          {{ section.settings.image | image_url: width: 750,  format: 'avif' }}  750w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
        class="hero-video__image hero-video__media hero-video__image--mobile desktop:hidden"
      >
    {%- elsif has_video == false and has_desktop_image == false -%}
      {%- comment -%} Placeholder in theme editor {%- endcomment -%}
      <div class="hero-video__placeholder">
        {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}
      </div>
    {%- endif -%}

    {%- comment -%} Overlay {%- endcomment -%}
    <div
      class="hero-video__overlay"
      style="--overlay-opacity: {{ overlay_opacity_decimal }};"
      aria-hidden="true"
    ></div>

    {%- comment -%} Logo overlay (Marachi) — image or text {%- endcomment -%}
    {%- if section.settings.logo_overlay != blank or section.settings.logo_overlay_text != blank -%}
      <div
        class="hero-video__logo-overlay hero-video__logo-overlay--{{ section.settings.logo_position | default: 'bottom-left' }}"
        aria-hidden="true"
      >
        {%- if section.settings.logo_overlay != blank -%}
          <img
            src="{{ section.settings.logo_overlay | image_url: width: 400 }}"
            alt=""
            width="{{ section.settings.logo_overlay.width }}"
            height="{{ section.settings.logo_overlay.height }}"
            class="hero-video__logo-image"
            loading="eager"
          >
        {%- elsif section.settings.logo_overlay_text != blank -%}
          <span class="hero-video__logo-text">{{ section.settings.logo_overlay_text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} Content (hidden when minimal text mode for image-led hero) {%- endcomment -%}
  {%- unless section.settings.minimal_text_mode -%}
    <div class="hero-video__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- assign hero_heading = section.settings.heading | default: '' -%}
      {%- if hero_heading != blank -%}
        <h2 class="hero-video__heading">{{ hero_heading | escape }}</h2>
      {%- else -%}
        <h2 class="hero-video__heading">{{ 'home.hero_title' | t }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-video__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_link != blank -%}
        {%- assign cta_label = section.settings.cta_text | default: '' -%}
        <a
          href="{{ section.settings.cta_link }}"
          class="hero-video__cta button button--primary"
        >
          {%- if cta_label != blank -%}{{ cta_label | escape }}{%- else -%}{{ 'home.hero_cta' | t }}{%- endif -%}
        </a>
      {%- endif -%}

    </div>
  {%- endunless -%}

</section>

{% schema %}
{
  "name": "Hero Video",
  "tag": "div",
  "class": "hero-video-section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "Video URL (YouTube / Vimeo)",
      "info": "Shown on desktop. Upload an MP4 to Files for best performance.",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Used as video poster and desktop fallback."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Falls back to background image when not set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "placeholder": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "placeholder": "Leave blank to use translation (home.hero_title → Ramadan 2026)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "placeholder": "Crafted for the modern woman"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "options": [
        { "value": "light", "label": "Light (white)" },
        { "value": "dark",  "label": "Dark (black)"  }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "full",   "label": "Full viewport (100svh)" },
        { "value": "large",  "label": "Large (80vh)"           },
        { "value": "medium", "label": "Medium (60vh)"          }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Image-only (Marachi)"
    },
    {
      "type": "checkbox",
      "id": "minimal_text_mode",
      "label": "Minimal text mode",
      "info": "Hide heading, eyebrow, and CTA for an image-led hero.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo_overlay",
      "label": "Logo overlay (image)",
      "info": "Optional logo or wordmark on top of the hero image."
    },
    {
      "type": "text",
      "id": "logo_overlay_text",
      "label": "Logo overlay (text)",
      "info": "Used if no logo image is set. E.g. brand name.",
      "placeholder": "BRAND"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "top-left",     "label": "Top left"     },
        { "value": "top-right",    "label": "Top right"    },
        { "value": "center",      "label": "Center"       },
        { "value": "bottom-left", "label": "Bottom left"  },
        { "value": "bottom-right","label": "Bottom right" }
      ],
      "default": "bottom-left"
    }
  ],
  "presets": [
    {
      "name": "Hero Video",
      "category": "Hero"
    }
  ]
}
{% endschema %}
