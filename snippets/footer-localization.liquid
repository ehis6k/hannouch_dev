{%- comment -%}
  Footer language selector (inline links, no dropdown, no currency).
  Renders: Language  English  Français  Nederlands
  Clicking a language posts the localization form with that language_code.
{%- endcomment -%}
<span class="footer-utilities__label">{{ 'content.language' | t | default: 'Language' }}</span>
{%- form 'localization', id: 'FooterLocalizationForm', class: 'footer-localization-form', return_to: request.path, aria-label: 'Language and region' -%}
  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
  <div class="footer-localization-form__languages" role="list">
    {%- for language in localization.available_languages -%}
      {%- assign language_label = language.endonym_name -%}
      {%- if language.iso_code == 'en' -%}
        {%- assign language_label = 'English' -%}
      {%- elsif language.iso_code == 'fr' -%}
        {%- assign language_label = 'Français' -%}
      {%- elsif language.iso_code == 'nl' -%}
        {%- assign language_label = 'Nederlands' -%}
      {%- endif -%}
      {%- assign is_active = false -%}
      {%- if language.iso_code == localization.language.iso_code -%}
        {%- assign is_active = true -%}
      {%- endif -%}
      <button
        type="submit"
        name="language_code"
        value="{{ language.iso_code }}"
        class="footer-localization-form__language{% if is_active %} footer-localization-form__language--active{% endif %}"
        role="listitem"
        {% if is_active %}aria-current="true"{% endif %}
      >
        {{ language_label }}
      </button>
    {%- endfor -%}
  </div>
{%- endform -%}
