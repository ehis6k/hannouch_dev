{%- comment -%}
  Hannouch icon – arrow (used for CTAs, navigation)
  Uses icon-arrow.svg (points right by default).

  Parameters:
    size      (optional) CSS length. Inherits --icon-size-sm when omitted.
    class     (optional) Extra CSS classes.
    title     (optional) Accessible label; omit for decorative use.
    direction (optional) 'left' — applies hannouch-icon--arrow-left class (flip via CSS).
{%- endcomment -%}
{%- assign arrow_class = 'hannouch-icon hannouch-icon--arrow' -%}
{%- if direction == 'left' -%}{%- assign arrow_class = arrow_class | append: ' hannouch-icon--arrow-left' -%}{%- endif -%}
{%- if class != blank -%}{%- assign arrow_class = arrow_class | append: ' ' | append: class -%}{%- endif -%}
<span
  class="svg-wrapper {{ arrow_class }}"
  {%- if size != blank %}style="width: {{ size }}; height: {{ size }};"{% endif %}
  {%- if title != blank %} role="img" aria-label="{{ title | escape }}"
  {%- else %} aria-hidden="true"
  {%- endif %}
>
  {{- 'icon-arrow.svg' | inline_asset_content -}}
</span>
