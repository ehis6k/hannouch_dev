{%- comment -%}
  Hannouch icon – close / X
  Parameters:
    size  (optional) CSS length. Inherits --icon-size-sm when omitted.
    class (optional) Extra CSS classes.
    title (optional) Accessible label; omit for decorative use.
{%- endcomment -%}
<span
  class="svg-wrapper hannouch-icon hannouch-icon--close{% if class != blank %} {{ class }}{% endif %}"
  {%- if size != blank %}style="width: {{ size }}; height: {{ size }};"{% endif %}
  {%- if title != blank %} role="img" aria-label="{{ title | escape }}"
  {%- else %} aria-hidden="true"
  {%- endif %}
>
  {{- 'icon-close.svg' | inline_asset_content -}}
</span>
