        "content_alignment": "left",
        "min_height": "medium",
        "color_scheme": "scheme-1"
      }
    },
    "featured_collection": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {},
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h2>New Arrivals<\/h2>",
                "alignment": "center",
                "type_preset": "h3",
                "font": "var(--font-heading--family)",
                "letter_spacing": "0.1em",
                "case": "uppercase"
              },
              "blocks": {}
            }
          },
          "block_order": ["heading"]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 16,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "portrait",
                "border": "none",
                "border_radius": 0
              },
              "blocks": {}
            },
            "group": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "column",
                "gap": 4,
                "padding-block-start": 8
              },
              "blocks": {
                "title": {
                  "type": "product-title",
                  "settings": {
                    "alignment": "left",
                    "type_preset": "h5",
                    "font": "var(--font-body--family)",
                    "letter_spacing": "0.05em",
                    "case": "uppercase"
                  },
                  "blocks": {}
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "alignment": "left",
                    "font": "var(--font-body--family)",
                    "font_size": "0.8125rem"
                  },
                  "blocks": {}
                }
              },
              "block_order": ["title", "price"]
            }
          },
          "block_order": ["card-gallery", "group"]
        }
      },
      "block_order": [],
      "settings": {
        "layout_type": "grid",
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 16,
        "rows_gap": 24,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
